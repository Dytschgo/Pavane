{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pavane",
  "version": "0.1.0",
  "identifier": "cloud.pavane.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pavane",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 580,
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
